<block wx:if="{{authorized}}">
<view class="shell" wx:if="{{item}}">
  <view class="detail-meta">
    <view class="tag"><view class="cat-dot cat-dot--{{item.catClass}}"></view>{{item.category}}</view>
  </view>

  <view class="detail-title">{{item.title}}</view>
  <view class="detail-maxim" wx:if="{{item.maxim}}">{{item.maxim}}</view>

  <view class="detail-body">
    <view class="body-p" wx:for="{{item.body}}" wx:key="index">{{item}}</view>
  </view>

  <view class="detail-extra" wx:if="{{item.costLabel || item.needs.length}}">
    <view class="extra-cost" wx:if="{{item.costLabel}}">{{item.costLabel}}{{item.costNote ? '：' + item.costNote : ''}}</view>
    <view class="extra-needs" wx:if="{{item.needs.length}}">
      <view class="needs-label">需要</view>
      <view class="needs-list">
        <view class="need-item" wx:for="{{item.needs}}" wx:key="index">{{item}}</view>
      </view>
    </view>
  </view>

  <view class="detail-actions">
    <button class="btn btn-ghost fav-btn" bindtap="onFavTap">{{fav ? '★ 已收着' : '☆ 收着'}}</button>
    <button class="btn btn-primary" open-type="share">分享给朋友</button>
  </view>
</view>
<view class="shell" wx:else>
  <view class="state-panel">
    <view class="state-title">这条活动没有找到</view>
    <view>回去随便逛逛，也可以就到这里。</view>
    <button class="btn btn-ghost" bindtap="onGoHome">回到首页</button>
  </view>
</view>

</block>
<view wx:else class="shell state-panel">{{accessMessage}}<button class="btn btn-ghost" bindtap="retryAccess">重试</button></view>
