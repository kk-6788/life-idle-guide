/* detail.wxss */

.shell {
  padding: 32rpx 36rpx 48rpx;
}

.detail-meta {
  margin-bottom: 16rpx;
}

.tag {
  display: flex;
  align-items: center;
  color: #526A75;
  font-size: 24rpx;
}

.detail-title {
  font-family: "Songti SC", "STSong", SimSun, serif;
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  color: #253D4A;
  margin: 0 0 28rpx;
  line-height: 1.5;
}

.detail-maxim {
  font-size: 28rpx;
  line-height: 1.8;
  color: #526A75;
  margin: -8rpx 0 32rpx;
}

.detail-body {
  margin-bottom: 32rpx;
}

.body-p {
  color: #253D4A;
  font-size: 30rpx;
  line-height: 1.9;
  margin-bottom: 32rpx;
}
.body-p:last-child {
  margin-bottom: 0;
}

/* 费用与所需物品：正文之后的一块安静区域 */
.detail-extra {
  background: #F0F6F8;
  border-radius: 18rpx;
  padding: 24rpx 28rpx;
  margin-top: 8rpx;
}

.extra-cost {
  color: #526A75;
  font-size: 26rpx;
  line-height: 1.7;
}

.extra-needs {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-top: 16rpx;
}
.extra-cost + .extra-needs {
  border-top: 1rpx dashed rgba(37, 61, 74, 0.12);
  padding-top: 16rpx;
}

.needs-label {
  color: #526A75;
  font-size: 26rpx;
  flex: none;
}
.needs-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.need-item {
  color: #526A75;
  font-size: 26rpx;
  line-height: 1.7;
}

.detail-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 40rpx;
}
.detail-actions .btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: 30rpx;
}
.fav-btn {
  border-color: rgba(37, 61, 74, 0.18);
}
