/* community.wxss */

.view-head {
  padding: 10rpx 8rpx 20rpx;
}
.view-title {
  font-family: "Songti SC", "STSong", SimSun, serif;
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  color: #253D4A;
  margin: 0 0 6rpx;
}
.view-sub {
  color: #526A75;
  font-size: 28rpx;
  margin: 0 0 8rpx;
}
.privacy-note {
  color: #526A75;
  font-size: 24rpx;
  margin-bottom: 16rpx;
}

.closed-panel {
  margin-top: 16rpx;
}

.status {
  margin-bottom: 16rpx;
}

.retry-btn {
  margin-top: 8rpx;
}

/* 发布表单 */
.post-form {
  background: #FFFFFF;
  border: 1rpx solid rgba(37, 61, 74, 0.10);
  border-radius: 20rpx;
  padding: 22rpx;
  margin-top: 8rpx;
}
.form-title {
  font-family: "Songti SC", "STSong", SimSun, serif;
  font-size: 32rpx;
  color: #253D4A;
  margin-bottom: 16rpx;
}
.field {
  margin-bottom: 14rpx;
}
.field-label {
  color: #526A75;
  font-size: 26rpx;
  margin-bottom: 8rpx;
}
.input,
.textarea,
.picker-value {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid rgba(37, 61, 74, 0.18);
  border-radius: 14rpx;
  background: #F0F6F8;
  color: #253D4A;
  font-size: 28rpx;
  padding: 14rpx 16rpx;
}
.input {
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
  flex-shrink: 0;
}
.textarea {
  min-height: 140rpx;
}
.picker-value {
  display: flex;
  align-items: center;
  min-height: 76rpx;
}
.field-error {
  color: #526A75;
  font-size: 26rpx;
  margin: 6rpx 0;
}
.field-error.is-error {
  color: #b23a2e;
}
.submit-btn {
  margin-top: 6rpx;
}
.form-note {
  color: #526A75;
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* 帖子列表 */
.post-list {
  margin-top: 20rpx;
}
.post {
  background: #FFFFFF;
  border: 1rpx solid rgba(37, 61, 74, 0.10);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}
.post-meta {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.post-activity {
  font-weight: 600;
  color: #253D4A;
  font-size: 28rpx;
}
.post-nick {
  color: #253D4A;
  font-size: 26rpx;
}
.post-time {
  color: #526A75;
  font-size: 24rpx;
}
.post-text {
  display: block;
  color: #253D4A;
  font-size: 28rpx;
  white-space: pre-wrap;
  word-break: break-all;
  margin-bottom: 8rpx;
}
.link-btn {
  color: #526A75;
  font-size: 24rpx;
  text-decoration: underline;
  padding: 4rpx 0;
}

.post-comments {
  margin-top: 14rpx;
  border-top: 1rpx dashed rgba(37, 61, 74, 0.18);
  padding-top: 10rpx;
}
.comments-title {
  color: #526A75;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.comment {
  border-left: 3rpx solid rgba(37, 61, 74, 0.10);
  padding: 4rpx 0 4rpx 12rpx;
  margin-bottom: 10rpx;
}
.comment-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}
.comment-nick {
  color: #253D4A;
  font-size: 24rpx;
}
.comment-text {
  display: block;
  color: #253D4A;
  font-size: 27rpx;
  white-space: pre-wrap;
  word-break: break-all;
  margin: 4rpx 0 2rpx;
}

.comment-form {
  margin-top: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.comment-btn {
  align-self: flex-start;
}

/* 举报面板 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(37, 61, 74, 0.35);
  z-index: 20;
}
.report-panel {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  top: 25%;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  z-index: 30;
}
.report-title {
  font-family: "Songti SC", "STSong", SimSun, serif;
  font-size: 34rpx;
  color: #253D4A;
  margin-bottom: 8rpx;
}
.report-target {
  color: #526A75;
  font-size: 26rpx;
  margin-bottom: 14rpx;
  word-break: break-all;
}
.report-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 14rpx;
}
.report-actions .btn {
  flex: 1;
}

.toolbar{display:flex;align-items:center;gap:24rpx;margin:18rpx 0}.toolbar .btn{margin:0}.post-form>.input,.post-form>.textarea{margin-top:20rpx}.post-form>.privacy-note{margin-top:20rpx}
