/* saved.wxss */

.view-head {
  padding: 10rpx 8rpx 24rpx;
}
.view-title {
  font-family: "Songti SC", "STSong", SimSun, serif;
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  color: #253D4A;
  margin: 0;
}

.card {
  border: 1rpx solid rgba(37, 61, 74, 0.08);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  min-height: 140rpx;
  box-sizing: border-box;
}
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.tag {
  display: flex;
  align-items: center;
  color: #526A75;
  font-size: 24rpx;
}
.fav {
  color: #667E88;
  font-size: 36rpx;
  line-height: 1;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin: -20rpx -12rpx -20rpx 0;
  box-sizing: border-box;
}
.fav.on {
  color: #EBD0B4;
}

.card-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.card-title {
  font-size: 30rpx;
  color: #253D4A;
  line-height: 1.5;
}
.paid-badge {
  flex: none;
  color: #526A75;
  font-size: 24rpx;
  background: rgba(37, 61, 74, 0.06);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.state-title {
  font-family: "Songti SC", "STSong", SimSun, serif;
  font-size: 32rpx;
  color: #253D4A;
  margin-bottom: 10rpx;
}
.go-btn {
  margin-top: 16rpx;
}
