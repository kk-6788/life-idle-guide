<block wx:if="{{authorized}}"><view class="shell">
 <view class="view-title">{{mode==='review'?'管理闲聊':'我的留言'}}</view>
 <view class="privacy-note">{{mode==='review'?'只有审核通过的内容才向成员展示。':'可以查看审核状态，也可以删除自己写的内容。'}}</view>
 <button class="btn btn-ghost" bindtap="retry" disabled="{{busy}}">刷新</button><view class="field-error">{{message}}</view>
 <view class="post" wx:for="{{items}}" wx:key="id"><view class="post-meta">{{item.kindLabel}} · {{item.statusLabel}} · {{item.nickname}}</view><text class="post-text">{{item.text}}</text><view class="privacy-note" wx:if="{{item.context}}">相关内容：{{item.context}}</view>
  <view class="toolbar" wx:if="{{mode==='review'}}"><button class="btn btn-primary" data-id="{{item.id}}" data-status="approved" bindtap="act" disabled="{{busy}}">{{item.kind==='report'?'采纳举报':'通过'}}</button><button class="btn btn-ghost" data-id="{{item.id}}" data-status="rejected" bindtap="act" disabled="{{busy}}">{{item.kind==='report'?'关闭举报':'拒绝'}}</button></view>
  <button wx:elif="{{item.status!=='deleted'}}" class="btn btn-ghost" data-id="{{item.id}}" bindtap="act" disabled="{{busy}}">删除</button>
 </view>
 <view class="state-panel" wx:if="{{!items.length && !busy && !message}}">暂时没有内容。</view>
 <button class="btn btn-ghost" wx:if="{{more}}" bindtap="moreItems" disabled="{{busy}}">再看一些</button>
 <block wx:if="{{mode==='review' && isAdmin}}"><button class="btn btn-ghost" bindtap="showMembers">查看试用成员</button><view wx:if="{{members.length}}" class="privacy-note">已激活 {{count}} / 30 个账号（包括管理员）</view>
  <view class="post" wx:for="{{members}}" wx:key="id">{{item.nickname || item.label}} {{item.self?'（自己）':''}} · {{item.disabled?'已暂停':'正常'}}<button wx:if="{{!item.self}}" class="btn btn-ghost" data-id="{{item.id}}" data-disabled="{{item.disabled}}" bindtap="memberAction">{{item.disabled?'恢复':'暂停'}}</button></view>
 </block>
</view></block><view wx:else class="shell state-panel">{{accessMessage}}<button class="btn btn-ghost" bindtap="retryAccess">重试</button></view>
