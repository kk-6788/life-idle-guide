<block wx:if="{{authorized}}">
<view class="shell">
  <view class="hero">
    <view class="sky" aria-hidden="true">
      <view class="sky-cloud sky-cloud--a"></view>
      <view class="sky-cloud sky-cloud--b"></view>
      <view class="sky-flock sky-flock--a">
        <view class="sky-bird sky-bird--1"></view>
        <view class="sky-bird sky-bird--2"></view>
        <view class="sky-bird sky-bird--3"></view>
      </view>
      <view class="sky-flock sky-flock--b">
        <view class="sky-bird sky-bird--1"></view>
        <view class="sky-bird sky-bird--2"></view>
        <view class="sky-bird sky-bird--3"></view>
      </view>
    </view>
    <view class="hero-title">没安排，也可以。</view>
    <view class="hero-sub">这会儿，不必有用。</view>
    <view class="wheel" aria-label="随机抽一件小事">
      <view class="wheel-pointer"></view>
      <view class="wheel-rotor {{spinning ? 'is-spinning' : ''}}" style="transform:rotate({{wheelRotation}}deg);">
        <image class="wheel-image" src="{{wheelImage}}" mode="aspectFit" />
        <view class="wheel-label" wx:for="{{wheelItems}}" wx:key="id" style="{{item.style}}">{{item.label}}</view>
      </view>
      <button size="mini" class="wheel-button" bindtap="onRandom" disabled="{{spinning || !wheelItems.length}}" aria-label="{{spinning ? '正在随机抽取' : '转盘随机抽一件小事'}}">{{spinning ? '转着呢' : '转一下'}}</button>
    </view>
  </view>

  <view class="list-head">
    <view class="list-title">随意看看</view>
    <view class="find-toggle" bindtap="onToggleFilters">{{filtersOpen ? '收起' : '找一找'}}{{filtersActiveCount > 0 && !filtersOpen ? '（' + filtersActiveCount + '）' : ''}}</view>
  </view>

  <view class="filters" wx:if="{{filtersOpen}}">
    <input class="search" value="{{query}}" placeholder="搜标题、正文或需要的东西" bindinput="onSearchInput" confirm-type="search" />

    <view class="chip-group">
      <view class="chip {{category==='' ? 'is-active' : ''}}" data-group="category" data-value="" bindtap="onChipTap">全部</view>
      <view wx:for="{{categories}}" wx:key="*this" class="chip chip-tone--{{index}} {{category===item ? 'is-active' : ''}}" data-group="category" data-value="{{item}}" bindtap="onChipTap">{{item}}</view>
    </view>

    <view class="chip-group">
      <view wx:for="{{settings}}" wx:key="value" class="chip {{setting===item.value ? 'is-active' : ''}}" data-group="setting" data-value="{{item.value}}" bindtap="onChipTap">{{item.label}}</view>
    </view>

    <view class="chip-group">
      <view wx:for="{{companies}}" wx:key="value" class="chip {{company===item.value ? 'is-active' : ''}}" data-group="company" data-value="{{item.value}}" bindtap="onChipTap">{{item.label}}</view>
    </view>

    <view class="filter-foot">
      <view class="result-count" wx:if="{{list.length}}">共 {{resultCount}} 条</view>
      <view class="reset-filters" wx:if="{{filtersActiveCount > 0}}" bindtap="onResetFilters">清除筛选</view>
    </view>
  </view>

  <view class="card-list">
    <view class="card card--{{item.catClass}}" wx:for="{{visibleList}}" wx:key="id" data-id="{{item.id}}" bindtap="onCardTap">
      <view class="card-head">
        <view class="tag"><view class="cat-dot cat-dot--{{item.catClass}}"></view>{{item.category}}</view>
        <view class="fav {{savedMap[item.id] ? 'on' : ''}}" data-id="{{item.id}}" catchtap="onFavTap">{{savedMap[item.id] ? '★' : '☆'}}</view>
      </view>
      <view class="card-title-row">
        <view class="card-title">{{item.title}}</view>
        <view class="paid-badge" wx:if="{{item.paid}}">有花费</view>
      </view>
    </view>
  </view>

  <button class="btn btn-ghost more-btn" wx:if="{{visibleCount < list.length}}" bindtap="onShowMore">再看一些</button>

  <view class="state-panel" wx:if="{{list.length===0}}">
    <view class="state-title">没有找到符合的条目</view>
    <view>换个词，或者放宽筛选看看。</view>
  </view>
</view>

</block>
<view wx:else class="shell state-panel">{{accessMessage}}<button class="btn btn-ghost" bindtap="retryAccess">重试</button></view>
