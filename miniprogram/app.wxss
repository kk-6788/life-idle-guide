/* app.wxss — 全局样式（人生浪费指南 · 浅蓝安静留白视觉）
   调色板：浅天蓝 #F0F6F8 / 墨蓝 #253D4A / 柔白 #FFFFFF
           正文小字 #526A75 / 装饰杏色 #EBD0B4 / 鼠尾草 #B8CDC0
   （正文/提示小字用 #526A75 保证可读性；装饰云/边线保留原色。） */

page {
  background: #F0F6F8;
  color: #253D4A;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC",
    "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
  font-size: 30rpx;
  line-height: 1.7;
}

.shell {
  padding: 24rpx;
}

/* 页首短标题与云 */
.hero {
  position: relative;
  padding: 56rpx 8rpx 44rpx;
  text-align: center;
}
.hero-title {
  position: relative;
  font-family: "Songti SC", "STSong", SimSun, serif;
  font-size: 56rpx;
  font-weight: 500;
  letter-spacing: 8rpx;
  color: #253D4A;
  margin: 0 0 16rpx;
}
.hero-sub {
  position: relative;
  color: #526A75;
  font-size: 28rpx;
  margin: 0;
}

/* 视图标题 */
.view-head h2 {
  font-family: "Songti SC", "STSong", SimSun, serif;
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  color: #253D4A;
  margin: 8rpx 0 6rpx;
}
.view-head p {
  color: #526A75;
  margin: 0 0 20rpx;
}

/* 按钮 */
.btn {
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 28rpx;
  line-height: 1.4;
  text-align: center;
}
.btn-primary {
  background: #253D4A;
  color: #FFFFFF;
}
.btn-ghost {
  background: #FFFFFF;
  color: #253D4A;
  border: 1rpx solid rgba(37, 61, 74, 0.18);
}
.btn[disabled] {
  opacity: 0.55;
}

/* 分类小圆点 */
.cat-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  vertical-align: middle;
}
.cat-dot--rest { background: #B8CDC0; }
.cat-dot--stroll { background: #EBD0B4; }
.cat-dot--hand { background: #667E88; }
.cat-dot--child { background: #253D4A; }
.cat-dot--together { background: #C9DCD0; }

/* 空态 / 错误面板 */
.state-panel {
  background: #FFFFFF;
  border: 1rpx dashed rgba(37, 61, 74, 0.18);
  border-radius: 20rpx;
  padding: 40rpx 28rpx;
  text-align: center;
  color: #526A75;
}
.state-panel h2 {
  font-family: "Songti SC", "STSong", SimSun, serif;
  font-size: 32rpx;
  font-weight: 500;
  color: #253D4A;
  margin: 0 0 10rpx;
}
.state-panel p {
  margin: 0 0 16rpx;
}

.muted {
  color: #526A75;
}

/* ---------- 5 类轻柔卡片底色（集中设置；选择器带 page 前缀提高优先级，
   不被页面级 .card 覆盖；正文仍为 #253D4A / #526A75） ---------- */
page .card--rest     { background: #F0F6F8; }
page .card--stroll   { background: #EEF5EF; }
page .card--hand     { background: #FFF0E6; }
page .card--child    { background: #F1EDF8; }
page .card--together { background: #FAF4DF; }

/* ---------- 安静天空：云缓慢横移 + 细线鸟（纯 view/CSS，无 JS 计时器） ----------
   结构见 home.wxml：.sky > .sky-cloud.sky-cloud--a/--b 与 .sky-flock.sky-flock--a/--b */
.sky {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
}
.sky-cloud {
  position: absolute;
  background: rgba(102, 126, 136, 0.18);
  border-radius: 999rpx;
  animation: sky-drift 105s linear infinite;
}
.sky-cloud::after {
  content: "";
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  background: inherit;
  border-radius: 50%;
  left: 34rpx;
  top: -26rpx;
}
.sky-cloud--a {
  width: 130rpx;
  height: 32rpx;
  top: 22rpx;
  left: -160rpx;
  opacity: 0.9;
  animation-duration: 84s;
  animation-delay: -30s;
}
.sky-cloud--b {
  width: 92rpx;
  height: 24rpx;
  top: auto;
  bottom: 2rpx;
  left: -130rpx;
  opacity: 0.55;
  animation-duration: 118s;
  animation-delay: -70s;
}
.sky-cloud--b::after { width: 40rpx; height: 40rpx; left: 24rpx; top: -18rpx; }
.sky-flock {
  position: absolute;
  width: 120rpx;
  height: 40rpx;
  left: -140rpx;
  animation: sky-drift 52s linear infinite;
}
.sky-flock--a { top: 2rpx; animation-delay: -12s; opacity: 0.6; }
.sky-flock--b { top: 12rpx; animation-delay: -33s; opacity: 0.4; animation-duration: 66s; }
.sky-bird {
  position: absolute;
  width: 36rpx;
  height: 18rpx;
  animation: bird-wing 3.2s ease-in-out infinite;
  transform-origin: center bottom;
}
.sky-bird::before, .sky-bird::after {
  content: "";
  position: absolute;
  top: 0;
  width: 18rpx;
  height: 12rpx;
  border-top: 3rpx solid rgba(102, 126, 136, 0.7);
  border-radius: 50% 50% 0 0;
}
.sky-bird::before { left: 0; transform: rotate(12deg); }
.sky-bird::after { right: 0; transform: rotate(-12deg); }
.sky-bird--1 { left: 0; top: 6rpx; }
.sky-bird--2 { left: 44rpx; top: 22rpx; animation-duration: 3.8s; }
.sky-bird--3 { left: 84rpx; top: 2rpx; animation-duration: 4.2s; }

@keyframes sky-drift {
  from { transform: translateX(0); }
  to   { transform: translateX(150vw); }
}
@keyframes bird-wing {
  0%, 100% { transform: scaleY(1); }
  50%      { transform: scaleY(0.6); }
}

@media (prefers-reduced-motion: reduce) {
  .sky-cloud,
  .sky-flock { animation: none; }
  .sky-flock { display: none; }
  .sky-bird { animation: none; }
  .sky-cloud--a { left: 20%; }
  .sky-cloud--b { left: 60%; }
  .btn,
  .chip,
  .fav,
  .card { transition: none; }
}
